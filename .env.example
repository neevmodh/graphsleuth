# Copy to .env and fill in. Never commit .env.
# Several keys may be given, comma-separated: the router rotates to the next when one is rate-limited
GEMINI_API_KEY=
GROQ_API_KEY=

# TigerGraph Savanna workspace (Workspace -> Connect -> REST / secret)
TG_HOST=https://YOUR-WORKSPACE.i.tgcloud.io
TG_GRAPH=GraphSleuth
TG_USERNAME=tigergraph
TG_PASSWORD=
TG_SECRET=

# Model routing (OpenAI-compatible endpoints)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Path to the provided dataset (kept outside the repo)
DATA_DIR=../dataset/HHGOA_IEEE
